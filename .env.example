# Copy to `.env` and fill in whichever provider(s) you use.
# Model strings in kaizen.yaml (e.g. "anthropic:claude-sonnet-4-5",
# "openai:gpt-4.1") determine which of these are actually required.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: point `langgraph dev` / Studio at a specific project's config.
# Defaults to examples/sample_dotnet_project/kaizen.yaml if unset.
KAIZEN_CONFIG=
