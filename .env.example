# Copy to `.env` and fill in whichever provider(s) you use.
# Model strings in kaizen.yaml (e.g. "anthropic:claude-sonnet-4-5",
# "openai:gpt-4.1") determine which of these are actually required.
# Azure OpenAI (model.backend: langgraph + model.azure in kaizen.yaml)
# needs none of these - it authenticates via `az login` by default.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: point `langgraph dev` / Studio at a specific project's config.
# Defaults to examples/sample_dotnet_project/kaizen.yaml if unset.
KAIZEN_CONFIG=

# Optional, but needed for LangGraph Studio to show run history/traces
# (the dev server works without it - you just won't see the "Trace" tab
# populate). Free to sign up: https://smith.langchain.com -> Settings ->
# API Keys.
LANGSMITH_API_KEY=
